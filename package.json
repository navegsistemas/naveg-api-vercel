{
  "name": "naveg-api-vercel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A API da agência virtual da NAVEG: o que o totem precisa do Firestore, e nada mais.",
  "scripts": {
    "dev": "vercel dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test",
    "test:emulador": "node scripts/emulador.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@navegsistemas/domain": "^0.13.0",
    "@vercel/functions": "3.9.11",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "hono": "^4.13.13",
    "nodemailer": "10.1.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.12"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.5"
    },
    "uuid": "^11.1.1"
  }
}
