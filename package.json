{
  "name": "naveg-api-vercel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A API da agência virtual da NAVEG: o que o totem precisa do Firestore, e nada mais.",
  "scripts": {
    "dev": "vercel dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test",
    "test:emulador": "node scripts/emulador.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@navegsistemas/domain": "^0.6.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.5"
    },
    "uuid": "^11.1.1"
  }
}
